# Resend API Key (Create at https://resend.com)
# Replace re_xxxxxxxxx with your actual Resend API Key
RESEND_API_KEY=re_xxxxxxxxx

# The email address that will receive contact enquiries
CONTACT_TO_EMAIL=kesavkumarthamburaj@gmail.com

# Vercel KV / Upstash Redis (For private visitor analytics)
# Standard Vercel KV environment variable names (Must be write-capable token; do NOT use KV_REST_API_READ_ONLY_TOKEN)
KV_REST_API_URL=https://your-kv-database.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# Optional legacy Upstash fallback names (used only if KV_* variables are unset)
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Private Dashboard Access Key (Access /admin/visitors)
ADMIN_KEY=your_secure_admin_key_here
